{
    "name": "aaieduhr/simbioza",
    "description": "Simbioza - a collaborative knowledge application powered by HeartPhrame",
    "type": "project",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-API.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-calendar.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-html-editor.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-comment.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-email.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-menu.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-notification.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-orm.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-theme.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-task.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-workspace.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-workspace-search.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-backup.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "aaieduhr/heartphrame-framework": "dev-main",
        "aaieduhr/heartphrame-module-api": "dev-main",
        "aaieduhr/heartphrame-module-auth": "dev-main",
        "aaieduhr/heartphrame-module-calendar": "dev-main",
        "aaieduhr/heartphrame-module-comment": "dev-main",
        "aaieduhr/heartphrame-module-editor-html": "dev-main",
        "aaieduhr/heartphrame-module-email": "dev-main",
        "aaieduhr/heartphrame-module-menu": "dev-main",
        "aaieduhr/heartphrame-module-notification": "dev-main",
        "aaieduhr/heartphrame-module-orm": "dev-main",
        "aaieduhr/heartphrame-module-task": "dev-main",
        "aaieduhr/heartphrame-module-theme": "dev-main",
        "aaieduhr/heartphrame-module-workspace": "dev-main",
        "aaieduhr/heartphrame-module-workspace-search": "dev-main",
        "aaieduhr/heartphrame-module-backup": "dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10 || ^11",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3",
        "slevomat/coding-standard": "^8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/src"
        }
    },
    "authors": [
        {
            "name": "Marko Ivančić",
            "email": "mivanci@srce.hr"
        }
    ],
    "config": {
        "github-protocols": [
            "https"
        ],
        "use-github-api": false,
        "sort-packages": true,
        "cache-dir": "build/composer",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "composer-runtime-api": "^2.1"
    },
    "extra": {
    },
    "scripts": {
        "pre-commit": [
            "vendor/bin/phpcbf",
            "vendor/bin/rector",
            "vendor/bin/phpcs -p",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ],
        "on-commit": [
            "vendor/bin/phpcs -p",
            "vendor/bin/rector --dry-run",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "php scripts/audit_bilingual_phpdoc.php",
            "php scripts/audit_module_documentation.php",
            "php scripts/audit_module_translations.php",
            "vendor/bin/phpunit"
        ],
        "clean-matrix": "php scripts/verify_clean_install_matrix.php",
        "e2e": "php scripts/run_e2e.php"
    }
}
