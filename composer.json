{
    "name": "aaieduhr/simbioza",
    "description": "Simbioza - a collaborative knowledge application powered by HeartPhrame",
    "type": "project",
    "license": "EUPL-1.2",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-survey.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-accessibility.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-audit.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-api.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-calendar.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-html-editor.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-comment.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-email.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-menu.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-notification.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-orm.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-theme.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-task.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/simbioza-module-workspace.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/simbioza-module-workspace-search.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-backup.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/simbioza-module-user.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/simbioza-module-confluence-import.git"
        }
    ],
    "require": {
        "aaieduhr/heartphrame-framework": "^0.0.25",
        "aaieduhr/heartphrame-module-audit": "^0.3.2",
        "aaieduhr/heartphrame-module-auth": "^0.3.2",
        "aaieduhr/heartphrame-module-backup": "^0.3.4",
        "aaieduhr/heartphrame-module-menu": "^0.3.4",
        "aaieduhr/heartphrame-module-orm": "^0.3.1",
        "aaieduhr/heartphrame-module-theme": "^0.3.7",
        "php": ">=8.2"
    },
    "autoload": {
        "files": [
            "bootstrap.php"
        ],
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/src"
        }
    },
    "authors": [
        {
            "name": "Krešimir Mihalj",
            "email": "kmihalj@srce.hr"
        }
    ],
    "config": {
        "github-protocols": [
            "https"
        ],
        "use-github-api": false,
        "process-timeout": 0,
        "sort-packages": true,
        "cache-dir": "build/composer",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "composer-runtime-api": "^2.1"
    },
    "suggest": {
        "aaieduhr/heartphrame-module-accessibility": "Adds optional personal accessibility preferences and a reusable widget.",
        "aaieduhr/heartphrame-module-api": "Adds the authenticated Simbioza API.",
        "aaieduhr/heartphrame-module-calendar": "Adds calendars, resources, CalDAV and meeting planning.",
        "aaieduhr/heartphrame-module-comment": "Adds page comments and reactions.",
        "aaieduhr/heartphrame-module-editor-html": "Adds standalone HTML pages and the reusable full HTML editor.",
        "aaieduhr/heartphrame-module-email": "Adds queued e-mail delivery.",
        "aaieduhr/heartphrame-module-notification": "Adds application notifications.",
        "aaieduhr/heartphrame-module-survey": "Adds standalone surveys, conditional questions, private collection and results.",
        "aaieduhr/heartphrame-module-task": "Adds document tasks.",
        "aaieduhr/simbioza-module-confluence-import": "Adds Confluence archive import.",
        "aaieduhr/simbioza-module-user": "Adds Wiki user profiles, follows and personal workspaces.",
        "aaieduhr/simbioza-module-workspace": "Adds hierarchical Wiki workspaces, pages and permissions.",
        "aaieduhr/simbioza-module-workspace-search": "Adds permission-aware Wiki search."
    },
    "extra": {
        "simbioza": {
            "optional-modules": {
                "aaieduhr/heartphrame-module-accessibility": "^0.3.1",
                "aaieduhr/heartphrame-module-api": "^0.3.2",
                "aaieduhr/heartphrame-module-calendar": "^0.3.2",
                "aaieduhr/heartphrame-module-comment": "^0.3.3",
                "aaieduhr/heartphrame-module-editor-html": "^0.3.11",
                "aaieduhr/heartphrame-module-email": "^0.3.5",
                "aaieduhr/heartphrame-module-notification": "^0.3.2",
                "aaieduhr/heartphrame-module-survey": "^0.3.5",
                "aaieduhr/heartphrame-module-task": "^0.3.3",
                "aaieduhr/simbioza-module-confluence-import": "^0.3.2",
                "aaieduhr/simbioza-module-user": "^0.3.1",
                "aaieduhr/simbioza-module-workspace": "^0.3.4",
                "aaieduhr/simbioza-module-workspace-search": "^0.3.2"
            },
            "development-tools": {
                "phpstan/phpstan": "^2.1",
                "phpunit/phpunit": "^10 || ^11",
                "rector/rector": "^2.0",
                "squizlabs/php_codesniffer": "^3",
                "slevomat/coding-standard": "^8"
            }
        }
    },
    "scripts": {
        "pre-commit": [
            "vendor/bin/phpcbf",
            "vendor/bin/rector",
            "@composer dump-autoload --optimize --strict-psr",
            "vendor/bin/phpcs -p",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ],
        "on-commit": [
            "@composer dump-autoload --optimize --strict-psr",
            "vendor/bin/phpcs -p",
            "vendor/bin/rector --dry-run",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "php scripts/audit_bilingual_phpdoc.php",
            "php scripts/audit_module_documentation.php",
            "php scripts/audit_module_translations.php",
            "vendor/bin/phpunit"
        ],
        "clean-matrix": "php scripts/verify_clean_install_matrix.php",
        "e2e": "php scripts/run_e2e.php"
    }
}
