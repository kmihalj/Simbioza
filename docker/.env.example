# EN: Use the versioned release image or an image you built and verified.
# Password files contain one strong secret each, never committed to Git.
# COOKIE_SECURE=0 is only for a local HTTP lab; use 1 and HTTPS outside that lab.
# No volume is mounted over application code. See docs/docker_en.md.
# SIMBIOZA_PORT sets the host TCP port; the container still listens on 8080.
# If another local service uses 1511, select a different free host port.
#
# HR: Koristiti verzionirani release image ili vlastiti izgrađeni i provjereni image.
# Datoteke lozinki sadrže po jednu snažnu tajnu; nikada ih ne spremati u Git.
# COOKIE_SECURE=0 samo je za lokalni HTTP test; izvan njega koristiti 1 i HTTPS.
# Nema volumena preko aplikacijskog koda. Pogledati docs/docker_hr.md.
# SIMBIOZA_PORT postavlja TCP port hosta; container i dalje sluša na 8080.
# Ako druga lokalna usluga koristi 1511, odabrati drugi slobodni port hosta.
SIMBIOZA_IMAGE=ghcr.io/kmihalj/simbioza:0.3.3
SIMBIOZA_DB_PASSWORD_FILE=./secrets/database_password
SIMBIOZA_DB_ADMIN_PASSWORD_FILE=./secrets/database_admin_password
SIMBIOZA_LISTEN=127.0.0.1
SIMBIOZA_PORT=1511
SIMBIOZA_COOKIE_SECURE=1
