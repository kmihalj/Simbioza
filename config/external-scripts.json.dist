{
    "_description_en": {
        "installation": "Copy to HPH_CONFIG_PATH/editor-html/external-scripts.json. Without HPH_CONFIG_PATH, use app/config/editor-html/external-scripts.json. The GUI edits this file; it is optional. Protect it from public access and allow only administrators to write it.",
        "layers": "HPH_CONFIG_OVERRIDE_PATHS adds layers. The last layer containing scripts replaces the entire list; the GUI writes to the highest layer.",
        "scripts": "A list of at most 256 definitions. A script and its optional stylesheet load only when approved and selected on the page. They also accompany HTML export. Editor, draft preview and history remain inert. Application JavaScript is separate.",
        "name": "A human-readable label, 1-160 bytes. Editors see only approved labels.",
        "type": "html for a complete ordered loading snippet containing script and link rel=\"stylesheet\" tags. Existing inline and url definitions remain supported. Module scripts and unsupported HTML are rejected.",
        "value": "For html, paste the complete loading snippet (at most 65536 bytes and 64 resources). URLs, SRI, crossorigin, classic script attributes and order are parsed automatically. HTTPS does not establish trust; validation fetches nothing.",
        "integrity": "Optional Subresource Integrity hash for a URL: sha256-, sha384- or sha512- followed by a Base64 digest. Empty means no content-integrity check. Inline scripts must leave this empty.",
        "status": "pending (default), approved, or rejected. Approving grants full JavaScript privileges on pages selecting the script, including access to page data and same-origin requests. Review source and origin first. Revocation blocks subsequent page loads, not tabs already open.",
        "id": "Derived from the exact type, value, integrity and optional CSS URL/hash. Old definitions without CSS keep their IDs. Code, URL or hash changes require a new definition and approval; names and instructions do not.",
        "imports": "New definitions from Confluence or backup are pending regardless of source approval. Existing local approval/rejection wins. Confluence automatically selects an exact locally approved match only on pages containing it; otherwise its candidate reference remains inert. The report can approve/select one page or all matching pages. Settings show direct usage, drafts and optional history. H5P follows the same rules without exceptions.",
        "instructions_html": "Optional sanitized HTML usage instructions: headings, paragraphs, lists and escaped pre/code examples. Approved scripts display a help button only when this field is nonempty. Changing instructions does not change approval.",
        "css_url": "Optional absolute HTTPS stylesheet URL. Follows the script approval and page selection; emitted once per page and kept as an external link during HTML export.",
        "css_integrity": "Optional SRI digest for css_url, in the same format as integrity. With SRI the stylesheet server must allow CORS. Without it, remote stylesheet changes are not detected.",
        "instructions_translations": "Optional passive HTML instructions keyed by locale, e.g. hr/en. The interface language is used first, then English, then the first available translation. Editing help does not change script identity or approval."
    },
    "_description_hr": {
        "installation": "Kopirati u HPH_CONFIG_PATH/editor-html/external-scripts.json. Bez HPH_CONFIG_PATH koristiti app/config/editor-html/external-scripts.json. GUI uređuje ovu datoteku, ali nije obavezan. Zabraniti javni pristup i dopustiti pisanje samo administratorima.",
        "layers": "HPH_CONFIG_OVERRIDE_PATHS dodaje slojeve. Zadnji sloj koji sadrži scripts zamjenjuje cijelu listu; GUI piše u najviši sloj.",
        "scripts": "Lista do 256 definicija. Skripta i njezin neobavezni stil učitavaju se samo kada su odobreni i odabrani na stranici. Uključuju se i u HTML izvoz. Editor, pregled nacrta i povijest ostaju neizvršivi. JavaScript aplikacije je odvojen.",
        "name": "Čitljiva oznaka, 1-160 bajtova. Urednici vide samo odobrene oznake.",
        "type": "html za cjelovit uređeni isječak učitavanja s oznakama script i link rel=\"stylesheet\". Stare inline i url definicije i dalje rade. Module skripte i nepodržani HTML se odbijaju.",
        "value": "Za html zalijepite cjelovit isječak učitavanja (najviše 65536 bajtova i 64 resursa). URL, SRI, crossorigin, atributi klasičnih skripti i redoslijed čitaju se automatski. HTTPS ne jamči povjerenje; provjera ništa ne dohvaća.",
        "integrity": "Neobavezan Subresource Integrity hash za URL: sha256-, sha384- ili sha512- pa Base64 sažetak. Prazno znači da nema provjere integriteta sadržaja. Za inline mora biti prazno.",
        "status": "pending (zadano), approved ili rejected. Odobrenje daje puna JavaScript prava na stranicama koje odabiru skriptu, uključujući pristup sadržaju i zahtjeve prema istom siteu. Prvo provjeriti kod i izvor. Opoziv blokira sljedeća učitavanja, ne već otvorene tabove.",
        "id": "Izveden iz točnog type, value, integrity i neobaveznog CSS URL-a/sažetka. Stare definicije bez CSS-a zadržavaju ID. Promjene koda, URL-a ili sažetka traže novu definiciju i odobrenje; nazivi i upute ne.",
        "imports": "Nove definicije iz Confluencea ili backupa su pending bez obzira na izvorno odobrenje. Lokalno odobrenje/odbijanje ostaje. Confluence automatski odabire točno lokalno odobreno podudaranje samo na stranicama koje ga sadrže; inače referenca kandidata ostaje neizvršiva. Izvještaj omogućuje odobrenje/odabir jedne ili svih pripadajućih stranica. Postavke prikazuju izravnu upotrebu, nacrte i opcionalnu povijest. H5P nema iznimaka.",
        "instructions_html": "Neobavezna pročišćena HTML uputa: naslovi, odlomci, popisi i escapirani pre/code primjeri. Odobrene skripte imaju gumb za pomoć samo kada polje nije prazno. Promjena upute ne mijenja odobrenje.",
        "css_url": "Neobavezni apsolutni HTTPS URL stila. Prati odobrenje i odabir skripte; uključuje se jednom po stranici i ostaje vanjska poveznica u HTML izvozu.",
        "css_integrity": "Neobavezni SRI sažetak za css_url, u istom formatu kao integrity. Uz SRI poslužitelj stila mora dopustiti CORS. Bez njega naknadne promjene udaljenog stila nisu otkrivene.",
        "instructions_translations": "Neobavezne pasivne HTML upute po jeziku, npr. hr/en. Prikazuje se jezik sučelja, zatim engleski, pa prvi dostupan prijevod. Izmjena upute ne mijenja identitet ni odobrenje skripte."
    },
    "scripts": []
}
